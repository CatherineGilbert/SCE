                "[Weather].MaxT as MaxT",
                "[Weather].MeanT as MeanT",
                "[Weather].MinT as MinT",
                "[Phenology].ThermalTime as ThermalTime",
                "[Phenology].AccumulatedEmergedTT as AccEmTT",
                "[Soil].Temperature.Value[2] as SoilTemp",
                "sum([Soil].Water.PAWmm) as PAWmm",
